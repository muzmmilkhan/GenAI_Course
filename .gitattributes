# Keep line endings consistent between Windows, macOS and Linux
* text=auto
# Shell scripts must keep Linux line endings or bash cannot run them
*.sh text eol=lf
# PowerShell / batch files use Windows line endings
*.ps1 text eol=crlf
*.bat text eol=crlf
# Binary files - never touch
*.pdf binary
*.png binary
*.jpg binary
*.pptx binary
*.docx binary
*.pkl binary
*.faiss binary
*.mp3 binary
*.wav binary
