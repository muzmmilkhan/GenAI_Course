# =====================================================================
#  Copy this file to ".env" (same folder) and fill in ONLY the keys
#  for the days you are working on. Every Day folder reads this file.
#      cp .env.example .env
# =====================================================================

# ---------- Core LLM providers (Days 03 onward) ----------
OPENAI_API_KEY=
GOOGLE_API_KEY=            # Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=            # same value as GOOGLE_API_KEY
GROQ_API_KEY=
ANTHROPIC_API_KEY=         # Day 25 MCP client (optional)
HUGGINGFACEHUB_API_TOKEN=  # Day 03 Hugging Face API models
COHERE_API_KEY=            # Day 09 re-ranker (optional)

# ---------- Azure OpenAI (optional, Day 15 / 17 embeddings) ----------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ---------- Search tools used by agents ----------
SERPAPI_API_KEY=           # Days 15, 18, 29
TAVILY_API_KEY=
GITHUB_TOKEN=              # Day 10 ReAct agent GitHub tool (optional)

# ---------- Tracing (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=genai-course

# ---------- Day 16-17 memory stores ----------
MONGODB_URI=               # Day 17 long-term memory (MongoDB Atlas)
TWILIO_ACCOUNT_SID=        # Day 17 WhatsApp
TWILIO_AUTH_TOKEN=

# ---------- Day 24 Fashion Brand agent (MySQL) ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=fashion_db

# ---------- Day 31 Voice agent ----------
ASSEMBLYAI_API_KEY=        # speech-to-text
CARTESIA_API_KEY=          # text-to-speech
SENSENOVA_API_KEY=         # LLM used by the voice agent

# ---------- Day 33-34 Production RAG ----------
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=financial_documents
AWS_REGION=
S3_BUCKET_NAME=
SQS_QUEUE_URL=

# ---------- Day 36-37 Google ADK / Google Cloud ----------
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUM=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_ENGINE_ID=
GOOGLE_CLOUD_RUN_URL=
API_SECRET_KEY=change-me
